# Generates precompiled_shaders.cc containing SPIR-V byte arrays and GLSL
# fallback strings for the Nintendo Switch OpenGL renderer.
#
# Usage:
#   cmake -DGLSLANG=<path> -DOUTPUT=<path/precompiled_shaders.cc> \
#         -DSHADER_DIR=<path/shaders> -DSPV_DIR=<path/spv_out> \
#         -P generate_shaders.cmake

if(NOT DEFINED GLSLANG OR NOT DEFINED OUTPUT OR NOT DEFINED SHADER_DIR OR NOT DEFINED SPV_DIR)
  message(FATAL_ERROR "Missing required -D arguments to generate_shaders.cmake")
endif()

set(_shaders
  "sprite.vert"
  "sprite.frag"
  "light.vert"
  "light.frag"
  "quad.vert"
  "dither.frag"
  "blit.frag"
)

file(MAKE_DIRECTORY "${SPV_DIR}")

set(_out_cpp "// Auto-generated by generate_shaders.cmake. Do not edit.\n")
string(APPEND _out_cpp "#include \"platform/switch/precompiled_shaders.h\"\n\n")
string(APPEND _out_cpp "#include <cstring>\n\n")
string(APPEND _out_cpp "namespace minicraft::platform::nx {\n")
string(APPEND _out_cpp "namespace {\n\n")

set(_table_entries "")

foreach(_name IN LISTS _shaders)
  set(_src_path "${SHADER_DIR}/${_name}")
  set(_spv_path "${SPV_DIR}/${_name}.spv")

  if(NOT EXISTS "${_src_path}")
    message(FATAL_ERROR "Shader file not found: ${_src_path}")
  endif()

  execute_process(
    COMMAND "${GLSLANG}" -G --target-env opengl -o "${_spv_path}" "${_src_path}"
    RESULT_VARIABLE _glslang_rc
    OUTPUT_VARIABLE _glslang_out
    ERROR_VARIABLE _glslang_err
  )
  if(NOT _glslang_rc EQUAL 0)
    message(FATAL_ERROR "glslangValidator failed for ${_name}:\n${_glslang_out}\n${_glslang_err}")
  endif()

  string(REPLACE "." "_" _ident "${_name}")

  file(READ "${_spv_path}" _spv_hex HEX)
  string(LENGTH "${_spv_hex}" _hex_len)
  math(EXPR _spv_bytes "${_hex_len} / 2")

  # Format hex pairs as 0xNN, with line wrapping every 16 bytes.
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1, " _spv_list "${_spv_hex}")
  string(REGEX REPLACE "((0x[0-9a-f][0-9a-f], ){16})" "\\1\n  " _spv_formatted "${_spv_list}")

  file(READ "${_src_path}" _glsl_src)
  string(REPLACE "\r\n" "\n" _glsl_src "${_glsl_src}")

  string(APPEND _out_cpp "const uint8_t k_${_ident}_spv[${_spv_bytes}] = {\n  ${_spv_formatted}\n};\n\n")
  string(APPEND _out_cpp "const char k_${_ident}_glsl[] = R\"GLSL(${_glsl_src})GLSL\";\n\n")

  string(APPEND _table_entries
    "  {\"${_name}\", k_${_ident}_spv, sizeof(k_${_ident}_spv), k_${_ident}_glsl},\n")
endforeach()

string(APPEND _out_cpp "const PrecompiledShader kShaders[] = {\n${_table_entries}};\n\n")
string(APPEND _out_cpp "}  // namespace\n\n")
string(APPEND _out_cpp "const PrecompiledShader* FindPrecompiledShader(const char* name) {\n")
string(APPEND _out_cpp "  if (!name) return nullptr;\n")
string(APPEND _out_cpp "  for (const auto& s : kShaders) {\n")
string(APPEND _out_cpp "    if (std::strcmp(s.name, name) == 0) {\n")
string(APPEND _out_cpp "      return &s;\n")
string(APPEND _out_cpp "    }\n")
string(APPEND _out_cpp "  }\n")
string(APPEND _out_cpp "  return nullptr;\n")
string(APPEND _out_cpp "}\n\n")
string(APPEND _out_cpp "}  // namespace minicraft::platform::nx\n")

# Only overwrite if content changed to avoid unnecessary rebuilds.
set(_needs_write TRUE)
if(EXISTS "${OUTPUT}")
  file(READ "${OUTPUT}" _existing_cpp)
  if(_existing_cpp STREQUAL _out_cpp)
    set(_needs_write FALSE)
  endif()
endif()

if(_needs_write)
  file(WRITE "${OUTPUT}" "${_out_cpp}")
endif()
