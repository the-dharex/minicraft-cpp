#pragma code_page(65001)

#include <winver.h>

#define IDI_ICON1 101

// Primary application icon shown in Windows Explorer, shortcuts, and taskbar.
IDI_ICON1 ICON "minicraft.ico"

#ifdef _DEBUG
#define MINICRAFT_FILEFLAGS (VS_FF_DEBUG | VS_FF_PRERELEASE)
#else
#define MINICRAFT_FILEFLAGS (VS_FF_PRERELEASE)
#endif

VS_VERSION_INFO VERSIONINFO
  FILEVERSION     2,3,0,3
  PRODUCTVERSION  2,3,0,3
  FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
  FILEFLAGS       MINICRAFT_FILEFLAGS
  FILEOS          VOS_NT_WINDOWS32
  FILETYPE        VFT_APP
  FILESUBTYPE     VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName",      "Minicraft Plus Community"
      VALUE "FileDescription",  "Minicraft Plus"
      VALUE "FileVersion",      "2.3.0-infdev3"
      VALUE "InternalName",     "minicraft_pc"
      VALUE "LegalCopyright",   "Based on Minicraft by Notch & Minicraft+ Revived"
      VALUE "OriginalFilename", "minicraft_pc.exe"
      VALUE "ProductName",      "Minicraft Plus"
      VALUE "ProductVersion",   "2.3.0-infdev3"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
